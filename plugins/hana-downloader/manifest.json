{
  "manifestVersion": 2,
  "id": "hana-downloader",
  "name": "Hana Downloader",
  "version": "0.90.1",
  "description": "小花下载器（v2 App 版）：任意 URL 下载 + 跨会话管理器。下载引擎以 local-machine 受管程序运行，投递由宿主经 ctx.tasks 统一管理。",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "0.946.2",
  "network": {
    "allowedHosts": [
      "127.0.0.1"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "allowLocalhost": true,
    "defaultTimeoutMs": 30000,
    "maxResponseBytes": 5242880
  },
  "capabilities": [
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/tasks.manage",
    "app/session.start-turn",
    "app/tools.expose-to-model"
  ],
  "contributes": {
    "cards": [
      {
        "id": "download",
        "title": "下载进度",
        "description": "单个下载任务的实时进度：百分比、速度、已完成量",
        "route": "/card.html",
        "cardForm": "flush"
      },
      {
        "id": "manager",
        "title": "下载管理器",
        "description": "跨会话统一管理所有下载任务",
        "route": "/manager.html",
        "cardForm": "flush",
        "realization": "page"
      }
    ]
  }
}
